{
  "name": "SuperKart Dev Container",
  "image": "mcr.microsoft.com/vscode/devcontainers/python:0-3.11",
  "workspaceFolder": "/workspaces/SuperKart",
  "forwardPorts": [8000],
  "postCreateCommand": "pip install -r requirements.txt || true",
  "postStartCommand": "nohup uvicorn api.server:app --host 0.0.0.0 --port 8000 &> /tmp/uvicorn.log &",
  "remoteEnv": {
    "API_KEY": "changeme"
  }
}
